#!/bin/sh
# Husky pre-commit hook - Lint staged files with ESLint and Prettier

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Filter for TypeScript/JavaScript and React files
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || echo "")

if [ -z "$TS_FILES" ]; then
    echo -e "${GREEN}✓ No TypeScript/JavaScript files to lint${NC}"
    exit 0
fi

echo -e "${YELLOW}Found staged files:${NC}"
echo "$TS_FILES"

# Run ESLint on staged files
echo -e "\n${YELLOW}Running ESLint...${NC}"

# Frontend ESLint check
if echo "$TS_FILES" | grep -q "frontend/"; then
    cd frontend || exit 1
    FRONTEND_FILES=$(echo "$TS_FILES" | grep "^frontend/" | sed 's|^frontend/||')
    if [ -n "$FRONTEND_FILES" ]; then
        npx eslint $FRONTEND_FILES --fix
        FRONTEND_LINT_EXIT=$?
        if [ $FRONTEND_LINT_EXIT -ne 0 ]; then
            echo -e "${RED}✗ ESLint found errors in frontend files${NC}"
            ERRORS=$((ERRORS + 1))
        else
            echo -e "${GREEN}✓ Frontend files pass ESLint${NC}"
        fi
    fi
    cd ..
fi

# Backend ESLint check
if echo "$TS_FILES" | grep -q "backend/"; then
    cd backend || exit 1
    BACKEND_FILES=$(echo "$TS_FILES" | grep "^backend/" | sed 's|^backend/||')
    if [ -n "$BACKEND_FILES" ]; then
        npx eslint $BACKEND_FILES --fix
        BACKEND_LINT_EXIT=$?
        if [ $BACKEND_LINT_EXIT -ne 0 ]; then
            echo -e "${RED}✗ ESLint found errors in backend files${NC}"
            ERRORS=$((ERRORS + 1))
        else
            echo -e "${GREEN}✓ Backend files pass ESLint${NC}"
        fi
    fi
    cd ..
fi

# Re-stage files that were auto-fixed
git add $STAGED_FILES

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}✗ Pre-commit checks failed. Please fix the errors above.${NC}"
    exit 1
fi

echo -e "${GREEN}✓ All pre-commit checks passed${NC}"
exit 0
