# ═══════════════════════════════════════════════════════════════
# FieldserviceIT — Master Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust for your environment.
# This file documents ALL variables used across backend + infra.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://app:devpassword@localhost:3306/fieldserviceit"

# ─── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
JWT_REFRESH_SECRET=""                                          # optional, defaults to JWT_SECRET if empty
JWT_EXPIRES_IN="15m"

# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"                                         # development | production | test
CORS_ORIGIN="http://localhost:3000"
SWAGGER_ENABLED="false"                                        # set true to enable Swagger in production

# ─── SMTP (MailHog on localhost:1025 by default) ──────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fieldserviceit.com"

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"                           # used for password reset links

# ─── Storage (local | s3) ─────────────────────────────────────
STORAGE_TYPE="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="fieldserviceit-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Stripe (billing module) ──────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR="./uploads"

# ─── Rate Limiting (optional overrides) ──────────────────────
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=3
THROTTLE_TTL_MEDIUM=10000
THROTTLE_LIMIT_MEDIUM=20
THROTTLE_TTL_LONG=60000
THROTTLE_LIMIT_LONG=100

# ─── Inbound Email ────────────────────────────────────────────
INBOUND_EMAIL_API_KEY=""                                       # optional, leave empty to skip auth

# ─── Docker / Infra ──────────────────────────────────────────
DB_ROOT_PASSWORD="rootpassword"                                # MySQL root password (docker-compose only)
DB_PASSWORD="devpassword"                                      # MySQL app user password (docker-compose only)
SEED_DB="true"                                                 # auto-seed on backend startup (docker)
