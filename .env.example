# ═══════════════════════════════════════════════════════════════
# FieldserviceIT — Master Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust for your environment.
# This file documents ALL variables used across backend + infra.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://app:devpassword@localhost:3306/fieldserviceit"
DB_POOL_SIZE=5
DB_POOL_MAX_IDLE=2
DB_POOL_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# ─── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
JWT_REFRESH_SECRET=""                                          # required in production; use a separate 32+ character value
CREDENTIAL_ENCRYPTION_KEY=""                                  # required in production; separate 32+ character value
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=""                         # only set temporarily during key rotation
MONITORING_API_KEY=""                                          # 24+ random characters for /v1/health/dashboard
JWT_EXPIRES_IN="15m"
WEBAUTHN_RP_ID="localhost"                                    # production: fieldserviceit.com
WEBAUTHN_ORIGINS="http://localhost:3000"                      # comma-separated trusted browser origins

# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"                                         # development | production | test
TRUST_PROXY_HOPS=1                                             # production ingress hops; keep minimal
CORS_ORIGIN="http://localhost:3000"
SWAGGER_ENABLED="false"                                        # set true to enable Swagger in production

# ─── SMTP (MailHog on localhost:1025 by default) ──────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fieldserviceit.com"

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"                           # used for password reset links
NEXT_PUBLIC_GA_ID=""                                           # optional Google Analytics 4 measurement ID

# ─── Security Event Export / SIEM ─────────────────────────────
SIEM_INGEST_URL=""                                             # HTTPS collector endpoint for signed security events
SIEM_INGEST_SECRET=""                                          # 32+ random characters; required when SIEM export is enabled

# ─── Storage (local | s3) ─────────────────────────────────────
STORAGE_TYPE="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="fieldserviceit-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── PayPal (billing module) ──────────────────────────────────
BILLING_PROVIDER="PAYPAL"
BILLING_GRACE_PERIOD_DAYS="7"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox"                                  # sandbox | production
PAYPAL_SUBSCRIPTION_MANAGE_URL="https://www.paypal.com/myaccount/autopay/"

# ─── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"
BACKUP_S3_ENDPOINT=""                                         # required in production; S3-compatible off-site storage
BACKUP_S3_REGION="us-east-1"
BACKUP_S3_BUCKET="fieldserviceit-backups"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_REQUIRED="false"                                      # must be true in production
OIDC_ALLOW_PRIVATE_ISSUERS="false"

# ─── Rate Limiting (optional overrides) ──────────────────────
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=3
THROTTLE_TTL_MEDIUM=10000
THROTTLE_LIMIT_MEDIUM=20
THROTTLE_TTL_LONG=60000
THROTTLE_LIMIT_LONG=100

# ─── Inbound Email ────────────────────────────────────────────
INBOUND_EMAIL_API_KEY=""                                       # optional, leave empty to skip auth

# ─── Docker / Infra ──────────────────────────────────────────
DB_ROOT_PASSWORD="rootpassword"                                # MySQL root password (docker-compose only)
DB_PASSWORD="devpassword"                                      # MySQL app user password (docker-compose only)
SEED_DB="false"                                                # never enable for a production deployment
TLS_CERT_PATH=""                                               # host path used by production docker-compose
TLS_KEY_PATH=""                                                # host path used by production docker-compose

# ─── Production Smoke Tests ──────────────────────────────────
SMOKE_BASE_URL="https://fieldserviceit.com"
SMOKE_API_URL="https://api.fieldserviceit.com"
SMOKE_EMAIL=""                                                 # production smoke super-admin email
SMOKE_PASSWORD=""                                              # production smoke super-admin password
SMOKE_MUTATIONS="false"                                       # true only for controlled temporary record checks
E2E_BASE_URL="https://fieldserviceit.com"
E2E_EMAIL=""                                                   # browser smoke email
E2E_PASSWORD=""                                                # browser smoke password

# ─── Error Tracking (optional) ───────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENABLED=true
SENTRY_SERVER_ENABLED=false
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=fieldserviceit
SENTRY_PROJECT=javascript-nextjs
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
