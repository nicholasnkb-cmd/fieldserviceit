# ═══════════════════════════════════════════════════════════════
# FieldserviceIT — Master Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust for your environment.
# This file documents ALL variables used across backend + infra.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://app:devpassword@localhost:3306/fieldserviceit"

# ─── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
JWT_REFRESH_SECRET=""                                          # optional, defaults to JWT_SECRET if empty
MONITORING_API_KEY=""                                          # 24+ random characters for /v1/health/dashboard
JWT_EXPIRES_IN="15m"

# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"                                         # development | production | test
CORS_ORIGIN="http://localhost:3000"
SWAGGER_ENABLED="false"                                        # set true to enable Swagger in production

# ─── SMTP (MailHog on localhost:1025 by default) ──────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fieldserviceit.com"

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"                           # used for password reset links
NEXT_PUBLIC_GA_ID=""                                           # optional Google Analytics 4 measurement ID

# ─── Storage (local | s3) ─────────────────────────────────────
STORAGE_TYPE="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="fieldserviceit-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Stripe (billing module) ──────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_PROVIDER="STRIPE"
BILLING_GRACE_PERIOD_DAYS="7"

# Optional alternative billing providers
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT="sandbox"
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
CHARGEBEE_SITE=""
CHARGEBEE_API_KEY=""
CHARGEBEE_WEBHOOK_USERNAME=""
CHARGEBEE_WEBHOOK_PASSWORD=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox"                                  # sandbox | production
PAYPAL_SUBSCRIPTION_MANAGE_URL="https://www.paypal.com/myaccount/autopay/"

# ─── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_REQUIRED="false"
OIDC_ALLOW_PRIVATE_ISSUERS="false"

# ─── Rate Limiting (optional overrides) ──────────────────────
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=3
THROTTLE_TTL_MEDIUM=10000
THROTTLE_LIMIT_MEDIUM=20
THROTTLE_TTL_LONG=60000
THROTTLE_LIMIT_LONG=100

# ─── Inbound Email ────────────────────────────────────────────
INBOUND_EMAIL_API_KEY=""                                       # optional, leave empty to skip auth

# ─── Docker / Infra ──────────────────────────────────────────
DB_ROOT_PASSWORD="rootpassword"                                # MySQL root password (docker-compose only)
DB_PASSWORD="devpassword"                                      # MySQL app user password (docker-compose only)
SEED_DB="true"                                                 # auto-seed on backend startup (docker)

# ─── Production Smoke Tests ──────────────────────────────────
SMOKE_BASE_URL="https://fieldserviceit.com"
SMOKE_API_URL="https://api.fieldserviceit.com"
SMOKE_EMAIL=""                                                 # production smoke super-admin email
SMOKE_PASSWORD=""                                              # production smoke super-admin password
SMOKE_MUTATIONS="false"                                       # true only for controlled temporary record checks
E2E_BASE_URL="https://fieldserviceit.com"
E2E_EMAIL=""                                                   # browser smoke email
E2E_PASSWORD=""                                                # browser smoke password
